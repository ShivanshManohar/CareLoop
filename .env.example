# Database (SQLite for local dev, PostgreSQL for Railway / Production)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js
NEXTAUTH_SECRET="careloop-super-secret-jwt-key-minimum-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini AI (Default: gemini-2.0-flash)
# If left empty, CareLoop runs in deterministic mock AI mode for offline local development
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Resend Email Integration
# If left empty, emails are logged to server console
RESEND_API_KEY=""
EMAIL_FROM="CareLoop <onboarding@resend.dev>"

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"

# Cron Security Token (For Vercel Cron or manual triggers)
CRON_SECRET="careloop-cron-secure-token-123"

